{
 "oac": "0.1",
 "about": "OAC v0.1 conformance vectors: basics. Keys: oac.testing.vector_key labels (test only). Time is unix seconds; NOW = 1793836800.",
 "cases": [
  {
   "name": "sorts keys",
   "op": "jcs",
   "input": {
    "value": {
     "b": 1,
     "a": [
      3,
      {
       "d": null,
       "c": true
      }
     ]
    }
   },
   "expect": {
    "canonical": "{\"a\":[3,{\"c\":true,\"d\":null}],\"b\":1}"
   }
  },
  {
   "name": "sorts by UTF-16 code units, not code points",
   "op": "jcs",
   "input": {
    "value": {
     "דּ": 1,
     "😀": 2,
     "€": 3
    }
   },
   "expect": {
    "canonical": "{\"€\":3,\"😀\":2,\"דּ\":1}"
   }
  },
  {
   "name": "escapes like JSON.stringify",
   "op": "jcs",
   "input": {
    "value": {
     "s": "\u0001\n\"\\/é"
    }
   },
   "expect": {
    "canonical": "{\"s\":\"\\u0001\\n\\\"\\\\/é\"}"
   }
  },
  {
   "name": "negative and large safe integers",
   "op": "jcs",
   "input": {
    "value": {
     "n": [
      -1,
      0,
      9007199254740991
     ]
    }
   },
   "expect": {
    "canonical": "{\"n\":[-1,0,9007199254740991]}"
   }
  },
  {
   "name": "empty containers",
   "op": "jcs",
   "input": {
    "value": {
     "o": {},
     "a": []
    }
   },
   "expect": {
    "canonical": "{\"a\":[],\"o\":{}}"
   }
  },
  {
   "name": "integer beyond 2^53-1 is refused",
   "op": "jcs",
   "input": {
    "value": {
     "n": 9007199254740992
    }
   },
   "expect": {
    "error": "malformed"
   }
  },
  {
   "name": "duplicate key is refused",
   "op": "parse",
   "input": {
    "text": "{\"a\":1,\"a\":2}"
   },
   "expect": {
    "error": "malformed"
   }
  },
  {
   "name": "fraction is refused",
   "op": "parse",
   "input": {
    "text": "{\"amount\":1.5}"
   },
   "expect": {
    "error": "malformed"
   }
  },
  {
   "name": "1.0 is refused (no non-integer spelling)",
   "op": "parse",
   "input": {
    "text": "{\"amount\":1.0}"
   },
   "expect": {
    "error": "malformed"
   }
  },
  {
   "name": "exponent is refused",
   "op": "parse",
   "input": {
    "text": "{\"amount\":1e2}"
   },
   "expect": {
    "error": "malformed"
   }
  },
  {
   "name": "NaN is refused",
   "op": "parse",
   "input": {
    "text": "{\"amount\":NaN}"
   },
   "expect": {
    "error": "malformed"
   }
  },
  {
   "name": "trailing garbage is refused",
   "op": "parse",
   "input": {
    "text": "{\"a\":1} x"
   },
   "expect": {
    "error": "malformed"
   }
  },
  {
   "name": "whitespace is fine when parsing",
   "op": "parse",
   "input": {
    "text": "{ \"b\" : 2 , \"a\" : [ 1 ] }"
   },
   "expect": {
    "canonical": "{\"a\":[1],\"b\":2}"
   }
  },
  {
   "name": "digest is sha-256 over JCS bytes",
   "op": "digest",
   "input": {
    "value": {
     "tool": "book_table",
     "args": {
      "party": 2,
      "restaurant": "Nobu Boston"
     }
    }
   },
   "expect": {
    "digest": "sha-256:PR3IX6HmxbHoLhPiG7WUntrSweiBenrmNcbNjBo7DKQ"
   }
  },
  {
   "name": "EdDSA signing is deterministic across SDKs",
   "op": "sign",
   "input": {
    "key": "signer",
    "typ": "oac-consent+jws",
    "payload": {
     "oac": "0.1",
     "type": "consent",
     "note": "deterministic EdDSA"
    }
   },
   "expect": {
    "token": "eyJhbGciOiJFZERTQSIsImtpZCI6IkhITEphaTJfQ1RyRFhxQW9Vd3pMRktFeDdwdjNQRXRNU0JCSHlpSlVLa1kiLCJ0eXAiOiJvYWMtY29uc2VudCtqd3MifQ.eyJub3RlIjoiZGV0ZXJtaW5pc3RpYyBFZERTQSIsIm9hYyI6IjAuMSIsInR5cGUiOiJjb25zZW50In0.lZi1BDNhsdX1pACvb0t8U0Fq8DHP9kAXFJNfd5kFaxHUXQ-peNmxpmuoHeSry4Zq7Zz_neVEX2Op4Qn091KbBw"
   }
  },
