{
  "name": "open-action-consent",
  "version": "0.3.0",
  "description": "Open Action Consent: a verifiable yes for actions AI agents take for people. Core SDK plus MCP (SDK v2) and Vercel AI SDK integrations.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./vercel-ai": {
      "types": "./dist/vercel-ai/index.d.ts",
      "default": "./dist/vercel-ai/index.js"
    }
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "conformance": "node src/conformance.ts ../../vectors"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ishan2036924/open-action-consent.git",
    "directory": "sdk/typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Ishan2036924/open-action-consent",
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.19.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/client": "2.4.0",
    "ai": "7.0.148"
  },
  "keywords": [
    "ai-agents",
    "consent",
    "mcp",
    "agent-payments",
    "jws",
    "open-standard",
    "vercel-ai"
  ],
  "author": "Ishan Srivastava"
}
