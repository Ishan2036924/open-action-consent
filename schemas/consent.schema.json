{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oac:0.1:consent",
  "title": "OAC v0.1 Consent (JWS payload, typ oac-consent+jws)",
  "description": "The person's signed yes to 1-20 Previews. Signed by the person's key (custodial signer or device key). Rules beyond the schema: exp - iat <= 900; one item per Preview, in order; at most one pay item, and then payment must equal that Preview's amount, currency and payee.",
  "type": "object", "additionalProperties": false,
  "required": ["oac", "type", "iss", "sub", "aud", "jti", "iat", "exp", "items", "signer"],
  "properties": {
    "oac": {"$ref": "urn:oac:0.1:common#/$defs/version"},
    "type": {"const": "consent"},
    "iss": {"$ref": "urn:oac:0.1:common#/$defs/id"},
    "sub": {"$ref": "urn:oac:0.1:common#/$defs/id"},
    "aud": {"$ref": "urn:oac:0.1:common#/$defs/id", "description": "the executor this yes is for"},
    "jti": {"$ref": "urn:oac:0.1:common#/$defs/nonce"},
    "iat": {"$ref": "urn:oac:0.1:common#/$defs/time"},
    "exp": {"$ref": "urn:oac:0.1:common#/$defs/time"},
    "items": {
      "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["preview", "action"],
        "properties": {"preview": {"$ref": "urn:oac:0.1:common#/$defs/digest"}, "action": {"$ref": "urn:oac:0.1:common#/$defs/digest"}}
      }
    },
    "signer": {"$ref": "urn:oac:0.1:common#/$defs/signer"},
    "payment": {"$ref": "urn:oac:0.1:common#/$defs/payment"}
  }
}
