{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oac:0.2:receipt",
  "title": "OAC 0.2 Receipt (JWS payload, typ oac-receipt+jws)",
  "description": "The executor's signed record of one action, chained per person: prev = sha-256 of the previous receipt's whole compact token (null for seq 1). Rules beyond the schema: tier D never appears; authority kind tier only for tiers A and B; tier B (except an undo receipt) carries a native undo with until and token; undo none carries no until or token; an undo receipt names what it undoes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "oac",
    "type",
    "iss",
    "sub",
    "seq",
    "prev",
    "iat",
    "tool",
    "tier",
    "authority",
    "action",
    "outcome",
    "result",
    "undo"
  ],
  "properties": {
    "oac": {
      "$ref": "urn:oac:0.2:common#/$defs/version"
    },
    "type": {
      "const": "receipt"
    },
    "iss": {
      "$ref": "urn:oac:0.2:common#/$defs/id"
    },
    "sub": {
      "$ref": "urn:oac:0.2:common#/$defs/id"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "prev": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "urn:oac:0.2:common#/$defs/digest"
        }
      ]
    },
    "iat": {
      "$ref": "urn:oac:0.2:common#/$defs/time"
    },
    "tool": {
      "$ref": "urn:oac:0.2:common#/$defs/tool"
    },
    "tier": {
      "$ref": "urn:oac:0.2:common#/$defs/tier"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "consent",
            "mandate",
            "tier",
            "undo"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "digest": {
          "description": "token_digest of the exact Consent, Mandate or Undo token the executor verified. The executor keeps that token.",
          "$ref": "urn:oac:0.2:common#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tier"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "ref"
                  ]
                },
                {
                  "required": [
                    "digest"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "ref",
              "digest"
            ]
          }
        }
      ]
    },
    "action": {
      "$ref": "urn:oac:0.2:common#/$defs/digest"
    },
    "preview": {
      "$ref": "urn:oac:0.2:common#/$defs/digest"
    },
    "outcome": {
      "description": "unknown: the executor cannot tell whether the action happened (for example, the provider timed out).",
      "enum": [
        "ok",
        "failed",
        "unknown"
      ]
    },
    "result": {
      "$ref": "urn:oac:0.2:common#/$defs/digest"
    },
    "undo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "native",
            "compensate",
            "none"
          ]
        },
        "until": {
          "$ref": "urn:oac:0.2:common#/$defs/time"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "undoes": {
      "$ref": "urn:oac:0.2:common#/$defs/digest"
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rail",
        "ref"
      ],
      "properties": {
        "rail": {
          "enum": [
            "stripe_link",
            "ap2",
            "vi",
            "other"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "last4": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "order": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "occurrence": {
      "description": "The occurrence id from the action's arguments, when the tool's profile names one.",
      "$ref": "urn:oac:0.2:common#/$defs/occurrence"
    },
    "occurrence_scope": {
      "description": "The profile's occurrence scope, when it names one. Chain checks compare occurrences within a scope (the tool's name when absent).",
      "$ref": "urn:oac:0.2:common#/$defs/occurrence"
    }
  },
  "dependentRequired": {
    "occurrence_scope": [
      "occurrence"
    ]
  }
}
