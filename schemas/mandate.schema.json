{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oac:0.2:mandate",
  "title": "OAC 0.2 Mandate (JWS payload, typ oac-mandate+jws)",
  "description": "A standing, bounded, expiring permission for one holder. Covers tier C only; never tier D; never waives the taint floor. Rules beyond the schema: exp - iat <= 30 days; a pay tool needs amount.per_call_minor, amount.per_day_minor and payees; a tool that sends to people needs recipients; a loosening replacement needs fresh proof of the person.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "oac",
    "type",
    "id",
    "iss",
    "sub",
    "holder",
    "goal",
    "tools",
    "bounds",
    "iat",
    "exp",
    "signer"
  ],
  "properties": {
    "oac": {
      "$ref": "urn:oac:0.2:common#/$defs/version"
    },
    "type": {
      "const": "mandate"
    },
    "id": {
      "$ref": "urn:oac:0.2:common#/$defs/id"
    },
    "iss": {
      "$ref": "urn:oac:0.2:common#/$defs/id"
    },
    "sub": {
      "$ref": "urn:oac:0.2:common#/$defs/id"
    },
    "holder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "agent",
            "client",
            "run"
          ]
        },
        "id": {
          "$ref": "urn:oac:0.2:common#/$defs/id"
        }
      }
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:oac:0.2:common#/$defs/tool"
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls"
      ],
      "properties": {
        "calls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "per_day"
          ],
          "properties": {
            "per_day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "per_run": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        },
        "amount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency"
          ],
          "minProperties": 2,
          "properties": {
            "currency": {
              "$ref": "urn:oac:0.2:common#/$defs/currency"
            },
            "per_call_minor": {
              "$ref": "urn:oac:0.2:common#/$defs/minor"
            },
            "per_day_minor": {
              "$ref": "urn:oac:0.2:common#/$defs/minor"
            }
          }
        },
        "recipients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^([A-Za-z0-9!#$%&'*+/=?^_`{|}~.-]{1,64})?@[A-Za-z0-9]([A-Za-z0-9.-]{0,188}[A-Za-z0-9])?$"
          }
        },
        "payees": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "sites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:oac:0.2:common#/$defs/host"
          }
        }
      }
    },
    "iat": {
      "$ref": "urn:oac:0.2:common#/$defs/time"
    },
    "exp": {
      "$ref": "urn:oac:0.2:common#/$defs/time"
    },
    "signer": {
      "$ref": "urn:oac:0.2:common#/$defs/signer"
    },
    "supersedes": {
      "$ref": "urn:oac:0.2:common#/$defs/id"
    },
    "status": {
      "description": "Where the signer publishes this Mandate's revocation bit.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "list",
        "index"
      ],
      "properties": {
        "list": {
          "$ref": "urn:oac:0.2:common#/$defs/id"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777215
        }
      }
    }
  }
}
